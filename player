using System;
using UnityEngine;
using UnityEngine.InputSystem;

public class Player : MonoBehaviour
{
    public BaseAbility[] abilities;
    public float velocidad = 5f;

    private InputSystem_Actions inputs;
    private BaseAbility current;
    private Rigidbody2D rb;
    private Vector2 movimiento;

    private void Awake()
    {
        inputs = new InputSystem_Actions();
        rb = GetComponent<Rigidbody2D>();
    }

    private void OnEnable()
    {
        inputs.Player.Move.performed += OnMove;
        inputs.Player.Move.canceled += OnStop;

        inputs.Abilities.Ability1.performed += SelecAbility1;
        inputs.Abilities.Ability2.performed += SelecAbility2;
        inputs.Abilities.Ability3.performed += SelecAbility3;
        inputs.Abilities.Ability4.performed += SelecAbility4;
        inputs.Abilities.Ability5.performed += SelecAbility5;

        inputs.Abilities.Cast.performed += OnCast;

        inputs.Player.Enable();
        inputs.Abilities.Enable();
    }

    private void OnDisable()
    {
        inputs.Player.Move.performed -= OnMove;
        inputs.Player.Move.canceled -= OnStop;

        inputs.Abilities.Ability1.performed -= SelecAbility1;
        inputs.Abilities.Ability2.performed -= SelecAbility2;
        inputs.Abilities.Ability3.performed -= SelecAbility3;
        inputs.Abilities.Ability4.performed -= SelecAbility4;
        inputs.Abilities.Ability5.performed -= SelecAbility5;

        inputs.Abilities.Cast.performed -= OnCast;

        inputs.Player.Disable();
        inputs.Abilities.Disable();

        movimiento = Vector2.zero;

        if (rb != null)
            rb.linearVelocity = Vector2.zero;
    }

    private void OnDestroy()
    {
        inputs.Dispose();
    }

    private void OnMove(InputAction.CallbackContext context)
    {
        movimiento = context.ReadValue<Vector2>();
    }

    private void OnStop(InputAction.CallbackContext context)
    {
        movimiento = Vector2.zero;
    }

    private void FixedUpdate()
    {
        rb.linearVelocity =
            Vector2.ClampMagnitude(movimiento, 1f) * velocidad;
    }

    private void OnCast(InputAction.CallbackContext context)
    {
        if (current == null)
            return;

        current.Execute();

        Debug.Log("Player usó la habilidad: " + current.GetType().Name);
        current = null;
    }

    #region Ability Selector

    private void SelecAbility1(InputAction.CallbackContext context)
    {
        Select(0);
    }

    private void SelecAbility2(InputAction.CallbackContext context)
    {
        Select(1);
    }

    private void SelecAbility3(InputAction.CallbackContext context)
    {
        Select(2);
    }

    private void SelecAbility4(InputAction.CallbackContext context)
    {
        Select(3);
    }

    private void SelecAbility5(InputAction.CallbackContext context)
    {
        Select(4);
    }

    #endregion

    public void Select(int index)
    {
        if (index < 0 || index >= abilities.Length)
            return;

        current = abilities[index];
    }
}
